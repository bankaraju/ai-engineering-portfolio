# Copy to .env and fill in. Never commit real values.

# PostgreSQL + pgvector
PGHOST=localhost
PGPORT=5432
PGDATABASE=annual_reports_db
PGUSER=postgres
PGPASSWORD=
# Used by langchain_banking_rag.py (LangChain PGVector)
PGVECTOR_CONNECTION_STRING=postgresql://postgres@localhost:5432/market_intelligence

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Embeddings
EMBED_MODEL=BAAI/bge-large-en-v1.5
SENTENCE_TRANSFORMERS_HOME=

# Google Drive + Document AI (document_ingestion_pipeline.py)
GOOGLE_APPLICATION_CREDENTIALS=
GDRIVE_FOLDER_ID=
# projects/<project>/locations/<location>/processors/<processor_id>
DOCAI_PROCESSOR_NAME=

# Optional Vertex AI embedding endpoint (multi_index_retrieval.py --use-vertex)
VERTEX_ENDPOINT_ID=

# banking_platform_api.py
HDFC_DATA_PATH=./data/hdfc_multiyear/
ENABLE_GLOBAL_DATA=true

# table_extraction_cascade.py demo
TEST_PDF_PATH=sample.pdf

LOG_LEVEL=INFO
