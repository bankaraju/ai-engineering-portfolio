# Copy to config/.env. Only the provider you select needs a key.
ANKA_LLM_PROVIDER=openai          # openai | openrouter | gemini | claude

OPENAI_API_KEY=your-openai-key
ANKA_OPENAI_MODEL=your-openai-model-id
ANKA_OPENAI_FALLBACK_MODEL=your-openai-fallback-model-id

GEMINI_API_KEY=your-gemini-key
ANKA_GEMINI_MODEL=your-gemini-model-id

ANTHROPIC_API_KEY=your-anthropic-key
ANKA_EXTRACTION_MODEL=your-claude-model-id
ANKA_SCORING_MODEL=your-claude-model-id

OPENROUTER_API_KEY=your-openrouter-key
ANKA_OPENROUTER_MODEL=your-openrouter-model-id
ANKA_OPENROUTER_FALLBACK_MODEL=your-openrouter-fallback-model-id

# Optional: directory for a per-company markdown note. Unset = no note written.
TRUST_SCORE_NOTES_DIR=

# Tests: set to 1 (with a provider key) to run the one live LLM test.
RUN_LLM_TESTS=0
